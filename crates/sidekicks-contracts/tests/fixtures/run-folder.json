[
  {
    "case": "XDG_RUNTIME_DIR set",
    "environment": {
      "XDG_RUNTIME_DIR": "/run/user/1000",
      "TMPDIR": "/tmp"
    },
    "userId": 1000,
    "folderPath": "/run/user/1000/ai-sidekicks"
  },
  {
    "case": "XDG_RUNTIME_DIR with a trailing slash",
    "environment": {
      "XDG_RUNTIME_DIR": "/run/user/1000/"
    },
    "userId": 1000,
    "folderPath": "/run/user/1000/ai-sidekicks"
  },
  {
    "case": "XDG_RUNTIME_DIR empty falls back to the temporary folder",
    "environment": {
      "XDG_RUNTIME_DIR": "",
      "TMPDIR": "/var/tmp"
    },
    "userId": 501,
    "folderPath": "/var/tmp/ai-sidekicks-501"
  },
  {
    "case": "TMPDIR with a trailing slash, as macOS sets it",
    "environment": {
      "TMPDIR": "/var/folders/xy/T/"
    },
    "userId": 501,
    "folderPath": "/var/folders/xy/T/ai-sidekicks-501"
  },
  {
    "case": "TMPDIR unset, TMP set",
    "environment": {
      "TMP": "/scratch"
    },
    "userId": 501,
    "folderPath": "/scratch/ai-sidekicks-501"
  },
  {
    "case": "TMPDIR empty, TEMP set",
    "environment": {
      "TMPDIR": "",
      "TEMP": "/temp"
    },
    "userId": 501,
    "folderPath": "/temp/ai-sidekicks-501"
  },
  {
    "case": "nothing set",
    "environment": {},
    "userId": 0,
    "folderPath": "/tmp/ai-sidekicks-0"
  }
]
