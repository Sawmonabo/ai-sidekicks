# Temporary scratch space in any directory
tmp/
.tmp/

# Docs program scratch space
docs/tmp/

# Environment and secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.mobileprovision

# Cloudflare Workers local-development secrets: never commit live values (.dev.vars and .env stay
# out of git).
.dev.vars
.dev.vars.*
# Exempt the committed example template from the wildcard above
!.dev.vars.example

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and temp files
*.log
*.log.*
temp/

# Node / JS / TS
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.turbo/
.next/
.nuxt/
.svelte-kit/
dist/
build/
coverage/
.stryker/
stryker-setup-*.js
*.tsbuildinfo
vite.svg

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Misc tool caches
.cache/
.eslintcache

# Playwright MCP
.playwright-mcp/

# Browser-mode and Playwright run artifacts.
.vitest-attachments/
playwright-report/
test-results/

# Explicitly track repo-local AI config and skills
!.claude/
!.claude/**
!.codex/
!.codex/**

# Still exclude tmp directories inside tracked trees
tmp/
.tmp/

# Session-local Claude scratch space (research synthesis, ephemeral notes)
.claude/scratch/

# Claude Code scheduled-wakeup runtime lockfile (ephemeral; per-session)
.claude/scheduled_tasks.lock

# Per-machine Claude Code settings
.claude/settings.local.json

# Per-machine Claude Code settings
.claude/settings.local.json

# Cross-tool agent transient artifacts (provider-neutral): subagent findings and other scratch
# drafted under .agents/tmp/<category>/, deleted before commit.
.agents/tmp/

# Local git worktrees (per-session isolated workspaces; never shared via origin)
.worktrees/

# Superpowers plugin scratch (brainstorm mockups, per-plan review workspaces)
.superpowers/

# Rust build artifacts (the cargo workspace at the repo root)
target/
