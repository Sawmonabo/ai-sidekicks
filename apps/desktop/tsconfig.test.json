{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-validates test files without emitting. The production `tsconfig.json` excludes
  // `src/**/*.test.ts` so test files don't ship in `dist/`; this config covers them via a `noEmit`
  // pass.
  //
  // It also covers the package-root `tests/` directory (the smoke test is
  // `tests/launch.smoke.test.ts`, a sibling of `src/`), so it drops the `rootDir: ./src`
  // constraint, which would error on files outside `src/`, and TS infers `rootDir` as the longest
  // common ancestor of the include set.
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    // `isolatedDeclarations` needs `declaration`; `composite: false` keeps this config out of the
    // project-references graph.
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    // `.size-limit.ts`, which Node loads directly, and the budget registry under `scripts/budget/`
    // name what they import by its real `.ts` or `.mts` path, since Node resolves the extension it
    // is given and does no `.js` to `.ts` rewriting; a program that pulls them in needs this
    // option. Legal here because this config is `noEmit`.
    "allowImportingTsExtensions": true
  },
  // `files` rather than `include`, deliberately: `exclude` filters `include`, and this path sits
  // under the excluded `src/renderer/**`, while a `files` entry is unconditional. The declaration
  // is needed because exclusion filters only the include globs: a test that imports a renderer
  // module still pulls it into the program, and the bundle tier does exactly that to name the
  // string it greps for rather than copying it. Those modules need the renderer's ambient
  // declarations, which that file holds.
  "files": ["src/renderer/src/vite-env.d.ts"],
  // The Node-context tests: `src/main/**`, `src/preload/**` and `src/shared/**` units, the
  // executables' tests under `scripts/`, the smoke and GC launches directly under `tests/`, and the
  // bundle tier; the size-limit config; and the Vitest config, the modules it composes under
  // `vitest/` and the root `vitest.shared.ts` it imports. The other folders under `tests/` hold DOM
  // or Electron-driving code and are typechecked by `tsconfig.browser-test.json`,
  // `tsconfig.electron-test.json` and the renderer's `tsconfig.test.json`. A helper under
  // `tests/helpers/` is typechecked here when a test here imports it.
  "include": [
    "src/**/*",
    "scripts/**/*.test.ts",
    "tests/*.test.ts",
    "tests/budget/**/*",
    ".size-limit.ts",
    "vitest.config.ts",
    "vitest/**/*"
  ],
  // `src/renderer/**` is excluded because the renderer is a separate composite project (browser
  // context: JSX + DOM lib) wired in via the parent tsconfig.json `references`; a Node-context pass
  // would drag its .tsx files into a JSX-less, DOM-less compilation and trip TS17004 / TS6142 /
  // TS2584. The renderer's `tsconfig.test.json` typechecks its test files.
  //
  // `tests/launch-failure.smoke.test.ts` is excluded because it launches through the end-to-end
  // launcher, whose callbacks are browser code; `tsconfig.electron-test.json` typechecks it.
  "exclude": ["dist", "node_modules", "src/renderer/**", "tests/launch-failure.smoke.test.ts"]
}
