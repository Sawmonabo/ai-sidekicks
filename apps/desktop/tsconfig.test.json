{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-validates test files without emitting. The production `tsconfig.json`
  // excludes `src/**/__tests__/**` so test files don't ship in `dist/`; this
  // config covers them via a `noEmit` typecheck pass.
  //
  // Plan-023 Phase 1 T-023p-1-7 widens this config to also cover the
  // package-root `test/` directory. The substrate-boots smoke test lives at
  // `apps/desktop/test/launch.smoke.test.ts` (sibling to `src/`, per the
  // Plan-023 §Tier 1 Partial PR Sequence > Phase 1 §Tasks T-023p-1-7
  // declaration on line 273). To keep that file typechecked, we drop the
  // `rootDir: ./src` constraint (which would error on files outside `src/`)
  // and broaden `include` to also accept `test/**/*`. The narrower `dist`
  // / `node_modules` excludes remain; `rootDir` is omitted so TS infers it
  // as the longest common ancestor of the include set.
  "extends": "../../tsconfig.node22.json",
  "compilerOptions": {
    "noEmit": true,
    // `isolatedDeclarations` (inherited from base) requires either `declaration`
    // or `composite`; we keep `declaration: true` paired with `noEmit: true` so
    // the typechecker honors `isolatedDeclarations` constraints without writing
    // files (see TS5069). `composite: false` and a null buildinfo prevent this
    // config from polluting the project-references graph.
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    // The console budget tier imports the harnesses under `scripts/budget/`,
    // which are TypeScript run directly by `node --experimental-strip-types`
    // (Plan-023 T-023p-1C-1). Node resolves the extension it is GIVEN and does
    // no `.mjs` → `.mts` rewriting, so those modules import each other by their
    // real `.mts` path — and a program that pulls them in needs this option to
    // accept that path. Legal here because this config is `noEmit`.
    "allowImportingTsExtensions": true
  },
  // `files` rather than `include`, deliberately: `exclude` filters `include` and
  // this path sits under the excluded `src/renderer/**`, while a `files` entry is
  // unconditional. The declarations are needed because exclusion only filters the
  // include globs — a test that IMPORTS a renderer module still pulls it into the
  // program, and the bundle tier does exactly that to name the string it greps
  // for rather than copying it. Those modules read the console's build-time
  // signals, which are declared here and nowhere else.
  "files": ["src/renderer/src/console/console-env.d.ts"],
  "include": ["src/**/*", "test/**/*"],
  // `src/renderer/**` is excluded because the renderer is a separate composite
  // project (browser context: JSX + DOM lib) wired in via the parent
  // tsconfig.json `references`. This Node-context test config would otherwise
  // drag renderer .tsx files into a JSX-less / DOM-less compilation and trip
  // TS17004 / TS6142 / TS2584 — the same shape of structural blocker the
  // parent tsconfig.json exclude resolves. Renderer-internal test files (when
  // they land at T-023p-1-7+) are typechecked by the renderer composite
  // project itself, not by this Node-context config.
  //
  // Plan-023 Phase 1C adds the three browser-mode console tiers to that list.
  // They live under `test/` — so `include` reaches them — but they import
  // renderer sources and render React into a real DOM, and dragging those in
  // here fails exactly as the renderer `.tsx` exclusion above describes:
  // TS6142 for the unset `--jsx`, TS2304 for `indexedDB` and `IDBFactory`, and
  // `Document` resolving to Electron's `WebviewTag`. They are typechecked by
  // `tsconfig.console-browser-test.json`, under the renderer's own options.
  "exclude": [
    "dist",
    "node_modules",
    "src/renderer/**",
    "test/console/console-harness.tsx",
    "test/console/phase-graph-settled.ts",
    // The architecture tier moved to `tsconfig.console-architecture-test.json` when
    // its wire-truth test started IMPORTING console source rather than reading it:
    // that pulls `store/hooks.ts` into the program, which reaches `window`. Same
    // split, and the same reason, as the browser and Electron tiers below.
    "test/console/architecture/**",
    // The browser tiers' shared surface scaffolding, excluded with the tiers that
    // read it: it is typechecked by `tsconfig.console-browser-test.json` under the
    // renderer's own options, and a `.tsx` fixture landing there would fail here
    // exactly as the tiers do.
    "test/console/surfaces/**",
    "test/console/browser/**",
    "test/console/screenshot/**",
    "test/console/accessibility/**",
    "test/console/e2e/**",
    "test/console/endurance/**",
    // The launcher the two Electron tiers share, the readiness phase it delegates
    // to, and the module naming the three fixture globals they read off a built
    // renderer. All three sit beside those tiers rather than inside either, so each
    // needs its own line, and they earn them differently: `fixture-handles.ts`
    // re-exports renderer constants and so reads the console's build-time signals
    // for the same reason those tiers do, `launch-readiness.ts` hands
    // `page.evaluate` callbacks that are browser code — `document.visibilityState`,
    // `requestAnimationFrame` — which this Node-lib config has no types for, and
    // `electron-harness.ts` imports that module, which pulls those callbacks into
    // whatever program pulls the launcher in. All three are typechecked with those
    // tiers by `tsconfig.console-electron-test.json`. The launcher's other siblings
    // here — `bounded-cleanup.ts`, `launch-deadline.ts`, `frame-witness.ts`,
    // `launch-budgets.ts`, `fixture-bundle.ts`, `launch-trace.ts` — import no
    // renderer module and evaluate nothing in a page, so they stay in this config.
    "test/console/electron-harness.ts",
    "test/console/launch-readiness.ts",
    "test/console/fixture-handles.ts",
    // The palette door the two Electron tiers open through, excluded for both of
    // the reasons its neighbours above are: its `page.evaluate` callback is
    // browser code this Node-lib config has no `document` for, and it imports the
    // launcher, so a program that pulls it in pulls those callbacks in too.
    "test/console/palette-interaction.ts"
  ]
}
