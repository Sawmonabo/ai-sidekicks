{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The Node-context entry for the desktop package; it typechecks `src/main/**` and
  // `src/preload/**`. The renderer is a separate composite project at `src/renderer/tsconfig.json`
  // (browser context: DOM lib, JSX, no Node types) wired in through `references`, so `tsc -b`
  // typechecks its .tsx files under their own config. The `src/renderer/**` exclude below keeps the
  // `include: ["src/**/*"]` glob from double-counting the renderer under this config's Node
  // settings, which would re-trigger TS17004 / TS6142 / TS2584.
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/client-sdk" },
    { "path": "../../packages/search-ranking" },
    { "path": "./src/renderer" }
  ],
  // Vite's build signals, which main reads too (the developer tools exist only in a development
  // build), are declared once, in the renderer's environment file; a `files` entry is unconditional,
  // so the `src/renderer/**` exclude below does not drop it.
  "files": ["src/renderer/src/vite-env.d.ts"],
  "include": ["src/**/*"],
  // `src/**/*.test.ts` is excluded because the `main-unit` Vitest project co-locates main-process
  // units beside the modules they cover (for example `src/main/services/renderer/assets.test.ts`),
  // and this project emits, so an included test file would compile a `vitest` import into `dist/`.
  // `tsconfig.test.json` (noEmit) type-validates them.
  "exclude": ["dist", "out", "node_modules", "src/**/*.test.ts", "src/renderer/**"]
}
