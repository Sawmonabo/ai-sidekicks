{
  "html comment with blank": "Intro.\n\n<!-- a\n\nb -->\n\nAfter.\n",
  "html script with blank": "Intro.\n\n<script>\nlet a = 1;\n\nlet b = 2;\n</script>\n\nAfter.\n",
  "html pre with blank": "<pre>\nline\n\n*not emphasis*\n</pre>\n\nAfter.\n",
  "html processing instruction": "<?php\n\necho 1;\n?>\n\nAfter.\n",
  "html declaration": "<!DOCTYPE html\n\n>\n\nAfter.\n",
  "html cdata": "<![CDATA[\na\n\nb\n]]>\n\nAfter.\n",
  "html div ends at blank": "<div>\n*a*\n\n</div>\n\nAfter.\n",
  "html details": "<details>\n<summary>S</summary>\n\nBody **bold**\n\n</details>\n\nAfter.\n",
  "html custom tag": "<custom-tag>\ntext\n\nmore\n\nAfter.\n",
  "footnote continuation": "Text[^1].\n\n[^1]: First para.\n\n    Second para of the note.\n\nAfter.\n",
  "footnote lazy line": "Text[^n].\n\n[^n]: note\ncontinued lazily\n\nAfter.\n",
  "footnote indented list": "Text[^n].\n\n[^n]: note\n\n    - item one\n\n    - item two\n\nAfter.\n",
  "link definition after use": "See [foo] here.\n\n[foo]: https://example.com\n\nAfter.\n",
  "link definition multi-line": "[foo]:\nhttps://example.com\n\"title\"\n\nSee [foo].\n",
  "definitions with no blank": "[a]: /a\n[b]: /b\n[c]: /c\n\nSee [a], [b], [c].\n",
  "setext h1": "Title\n===\n\nPara.\n",
  "setext h2 after paragraph": "Para line\n---\n\nNext.\n",
  "table": "| a | b |\n| - | - |\n| 1 | 2 |\n\nAfter.\n",
  "table after paragraph, no blank": "Lead line\n| a | b |\n| - | - |\n| 1 | 2 |\n\nAfter.\n",
  "math block with blank": "$$\nx = 1\n\ny = 2\n$$\n\nAfter.\n",
  "math one line": "$$x$$\n\nAfter.\n",
  "indented code with blank": "Para.\n\n    code 1\n\n    code 2\n\nAfter.\n",
  "loose list with nested para": "- a\n\n  b\n\n- c\n\nAfter.\n",
  "list then indented code": "- a\n\n    code in item\n\nAfter.\n",
  "fence inside list with blank": "- item\n\n  ```\n  code\n\n  more\n  ```\n\nAfter.\n",
  "lazy blockquote": "> quote\ncontinued\n\nAfter.\n",
  "blockquote with marked blank": "> a\n>\n> b\n\nAfter.\n",
  "blockquote then blank then quote": "> a\n\n> b\n\nAfter.\n",
  "longer fence closer": "````\n```\n\nx\n````\n\nAfter.\n",
  "fence with backtick info": "``` a`b\nnot a fence\n```\n\nAfter.\n",
  "tilde fence with blank": "~~~\na\n\nb\n~~~\n\nAfter.\n",
  "unclosed fence": "Para.\n\n```js\nconst a = 1;\n\nconst b = 2;\n",
  "ordered lists by delimiter": "1. a\n\n2. b\n\n10) c\n\nAfter.\n",
  "bullet change": "- a\n\n* b\n\nAfter.\n",
  "thematic break star": "* * *\n\nAfter.\n",
  "tab list continuation": "-\tfoo\n\n\tbar\n\nAfter.\n",
  "paragraph then fence no blank": "Para.\n```\ncode\n```\n\nAfter.\n",
  "heading then paragraph no blank": "# H\nPara.\n\nAfter.\n",
  "html comment one line": "<!-- a -->\n\nAfter.\n",
  "html comment then text same block": "<!-- a\n\nb --> trailing\n\nAfter.\n",
  "deep list blank lines": "1. a\n\n   - b\n\n     c\n\n   - d\n\n2. e\n\nAfter.\n",
  "footnote def then paragraph indented": "[^x]: a\n\n  b\n\nAfter.[^x]\n"
}
