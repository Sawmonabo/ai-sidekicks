{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Typechecks the benchmark tier. Same shape and reasoning as `tsconfig.electron-test.json`: a
  // Node driver that pulls renderer modules into its program. `streaming-layer.test.ts` imports the
  // markdown segmenter and parse, and `store-fan-out.test.ts` imports the store's entity kinds,
  // deliberately, since a benchmark that timed a local copy of the module would measure the copy.
  //
  // Under `tsconfig.test.json` this tier compiles clean only while the renderer modules it reaches
  // touch no browser global, a property of the module graph below them rather than of anything the
  // tier wrote (the markdown cache's byte measurement, for one, reaches the persistence door and
  // with it the IndexedDB adapter). Every sibling tier in this position already has its own config,
  // and this is that move for the last one.
  //
  // Widening `tsconfig.test.json` instead would hand the DOM to `launch.smoke.test.ts` and every
  // `src/main/**` unit, where reaching for `document` is a defect the compiler should still catch.
  "extends": ["../../tsconfig.node.json", "./tsconfig.paths.json"],
  "compilerOptions": {
    "noEmit": true,
    // `isolatedDeclarations` needs `declaration`; `composite: false` keeps this config out of the
    // project-references graph.
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    // DOM joins the Node lib rather than replacing it: the tier's own files are Node (they spawn,
    // read files and write the ledger) and the renderer modules they import are renderer code. Kept
    // in step with the renderer project's lib set.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // A renderer barrel re-exports `.tsx` components, so the renderer's React modules are in this
    // program whether or not a benchmark mentions one. Without `jsx` they fail TS6142 at the
    // barrel.
    "jsx": "react-jsx"
  },
  "include": [
    "tests/bench/**/*",
    // The renderer's build-time signals. Imported renderer modules read them at module scope, and
    // this file declares them.
    "src/renderer/src/vite-env.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
