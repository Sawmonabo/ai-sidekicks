{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    // --- The three build flavors ------------------------------------------
    //
    // All three write `out/**` and differ in the `define` that decides what the renderer talks to
    // and whether the main process carries its test probes. All three are `cache: false`: a
    // Turborepo cache hit restores its saved files without emptying the directory, while a real
    // `electron-vite build` empties it first (Vite's `emptyOutDir`), so a cached restore over a
    // sibling flavor's output would leave that flavor's content-hashed chunks beside its own.
    "build": {
      "inputs": [
        "src/**",
        "fixtures/**",
        "build/**",
        "electron.vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["out/**", "dist/**", ".tsbuildinfo"],
      "cache": false
    },
    "build:smoke": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "fixtures/**",
        "build/**",
        "electron.vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["out/**", "dist/**"],
      "cache": false
    },
    "build:fixtures": {
      // The renderer with its fixture implementations compiled in, for the two
      // Electron tiers.
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "fixtures/**",
        "build/**",
        "electron.vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["out/**", "dist/**"],
      "cache": false
    },
    "typecheck": {
      // `scripts/**` is an input because the scripts there are TypeScript that
      // `tsconfig.scripts.json` typechecks, so a change to one must invalidate this task.
      // The Vitest config, the root module it imports and the size-limit config are typechecked
      // by `tsconfig.test.json`.
      "inputs": [
        "src/**",
        "fixtures/**",
        "tests/**",
        "build/**",
        "scripts/**",
        "tsconfig*.json",
        "package.json",
        "vitest.config.ts",
        ".size-limit.ts",
        "vitest/**",
        "$TURBO_ROOT$/vitest.shared.ts"
      ],
      // `tsc -b` emits each project's output beside its build info, and a later `tsc -b` trusts the
      // build info and never re-emits a missing output, so a cache hit restores both or neither.
      "outputs": [".tsbuildinfo", "dist/**", "src/renderer/.tsbuildinfo", "out/tsc-renderer/**"]
    },
    "lint": {
      "inputs": [
        "src/**",
        "fixtures/**",
        "tests/**",
        "build/**",
        "scripts/**",
        "vitest/**",
        "eslint.restricted-syntax.mjs",
        "*.{ts,tsx,js,mjs,cjs,json}",
        "eslint.config.mjs"
      ],
      "outputs": []
    },
    // --- Structure gates ---------------------------------------------------
    //
    // Two tools, two disjoint claims, deliberately two tasks: `knip` answers "does an entry point
    // reach this?" and `dependency-cruiser` answers "is this import allowed to exist?". Neither
    // subsumes the other (a dead module can be perfectly layered, and a layering violation can sit
    // on a reachable path), and one task running both in sequence would hide the second leg's
    // findings behind the first's exit code. CI runs them as separate jobs, so one red leg never
    // conceals the other.
    //
    // Cacheable, unlike the test tiers: both read only files inside this package plus the
    // workspace-root manifest and `pnpm-workspace.yaml`, and a change to either of those moves
    // `pnpm-lock.yaml`, which Turborepo hashes globally.
    "structure:dead-code": {
      "inputs": [
        "src/**",
        "fixtures/**",
        "tests/**",
        "build/**",
        "scripts/**",
        "$TURBO_ROOT$/knip.json",
        "vitest.config.ts",
        ".size-limit.ts",
        "vitest/**",
        "electron.vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": []
    },
    // No tsconfig: the cruise resolves through an explicit extension list and the package's
    // `imports` in `package.json`, which also holds the script that invokes it. It follows imports
    // out of the folders it is given, into the test helpers and the root `vitest.shared.ts`.
    "structure:layering": {
      "inputs": [
        "src/**",
        "fixtures/**",
        "build/**",
        "scripts/**",
        "vitest/**",
        "tests/helpers/**",
        "$TURBO_ROOT$/vitest.shared.ts",
        ".dependency-cruiser.mjs",
        ".dependency-cruiser.layers.mjs",
        "package.json"
      ],
      "outputs": []
    },

    "test:main-unit": {
      "dependsOn": ["^build"],
      // Every tree the project's `include` discovers tests in, and every file those tests read.
      // `src/**` rather than its main, preload and shared folders, because the fixture-launch unit
      // imports the scenario catalog in `fixtures/**`, whose scenarios import renderer modules, and
      // the config's icon plugin imports the renderer's glyph constants. The budget document is
      // read, since the registry's own test evaluates its rows. The config also imports the root
      // `vitest.shared.ts`.
      "inputs": [
        "src/**",
        "fixtures/**",
        "build/**",
        "scripts/**",
        "tests/budget/document.json",
        "tests/helpers/**",
        "vitest.config.*",
        "vitest/**",
        "$TURBO_ROOT$/vitest.shared.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/**",
        "src/shared/**",
        "vitest.config.*",
        "$TURBO_ROOT$/vitest.shared.ts",
        "vitest/**",
        "tsconfig*.json",
        "package.json",
        "tests/budget/document.json",
        "tests/helpers/**"
      ],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:smoke": {
      // Its launches play no scenario, so each starts a background service of its own from the
      // service's build (`tests/helpers/isolated-service.ts`), except the one that asks for a
      // scenario to see the smoke bundle refuse it.
      "dependsOn": ["build:smoke", "@ai-sidekicks/runtime-daemon#build"],
      // Not `tests/**`: the tiers under `tests/<tier>/**` are not this project's inputs, and a tier
      // test edit must not invalidate the smoke build.
      // `scripts/materialize-electron.ts` is named because this task runs it; `scripts/**` would
      // pull every other script in with it. The two sources named after `vitest/**` are the ones
      // the Vitest config imports.
      "inputs": [
        "tests/*.test.ts",
        "tests/helpers/**",
        "scripts/materialize-electron.ts",
        "vitest.config.*",
        "$TURBO_ROOT$/vitest.shared.ts",
        "vitest/**",
        "src/shared/failure-message.ts",
        "src/renderer/src/styles/glyphs.ts",
        "tsconfig*.json",
        "package.json",
        "tests/budget/document.json",
        "tests/budget/built-renderer-tree.ts"
      ],
      "outputs": [],
      "cache": false
    },

    // --- Test tiers ---------------------------------------------------------
    //
    // Each tier is its own task so it can be run, cached and gated alone. `cache: false`
    // throughout, as above: these assert against a tree state, and a cached pass would report on a
    // tree that is no longer there.
    //
    // Every tier's Vitest config reads the launch budgets (`vitest/tier-projects.ts`) and imports
    // `src/shared/failure-message.ts` and the renderer's glyph constants, so each lists
    // `tests/budget/document.json`, `tests/helpers/**`, which holds the registry that loads it,
    // and those two sources or a folder holding them.

    "test:renderer": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/src/**",
        "src/shared/**",
        "fixtures/**",
        "tests/helpers/**",
        "tests/endurance/streaming-lanes*",
        "tests/endurance/transcript/long-log.test-support*",
        "vitest.config.*",
        "$TURBO_ROOT$/vitest.shared.ts",
        "vitest/**",
        "tsconfig*.json",
        "package.json",
        "tests/budget/document.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/src/**",
        "src/shared/**",
        "fixtures/**",
        "tests/browser/**",
        "tests/helpers/**",
        "vitest.config.*",
        "$TURBO_ROOT$/vitest.shared.ts",
        "vitest/**",
        "package.json",
        "tests/budget/document.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:accessibility": {
      // Runs only by name, outside the `test` aggregate and CI, until the accessibility sweeps
      // become a gate on every PR.
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/src/**",
        "src/shared/**",
        "fixtures/**",
        "tests/accessibility/**",
        "tests/helpers/**",
        "vitest.config.*",
        "$TURBO_ROOT$/vitest.shared.ts",
        "vitest/**",
        "package.json",
        "tests/budget/document.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:bundle": {
      // The tier that checks the release build's output. The `build` edge is
      // load-bearing: the tier fails loudly when a build output under `out/` is absent rather than
      // skipping, and the edge makes the output present by construction.
      "dependsOn": ["build"],
      "inputs": [
        "tests/budget/**",
        "tests/helpers/**",
        "vitest.config.*",
        "$TURBO_ROOT$/vitest.shared.ts",
        "vitest/**",
        "src/shared/failure-message.ts",
        "src/renderer/src/styles/glyphs.ts",
        "package.json",
        "electron.vite.config.ts",
        "src/renderer/src/app/fixture/global-names.ts",
        "src/shared/fixture-launch.ts",
        "out/main/**",
        "out/preload/**",
        "out/renderer/**"
      ],
      "outputs": [],
      "cache": false
    },
    "test:e2e": {
      // The one tier that needs a fixture build rather than a release one: it drives the renderer
      // against the fixture implementations, which the release define folds out. The edge makes
      // that bundle present by construction, so the tier's skip-with-a-message path stays a
      // developer convenience rather than something CI can silently fall into. A launch playing no
      // scenario starts a background service of its own from the service's build. The real-click
      // test's opt-in variable is handed through, since Turbo passes a task only what it names.
      "dependsOn": ["build:fixtures", "@ai-sidekicks/runtime-daemon#build"],
      "passThroughEnv": ["SIDEKICKS_RUN_REAL_CLICKS"],
      "inputs": [
        "src/renderer/src/**",
        "src/main/**",
        "src/shared/**",
        "fixtures/**",
        "tests/e2e/**",
        "tests/helpers/**",
        "vitest.config.*",
        "$TURBO_ROOT$/vitest.shared.ts",
        "vitest/**",
        "package.json",
        "out/**",
        "tests/budget/document.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:endurance": {
      // Same bundle, tens of seconds rather than milliseconds. Its own task rather than a slow file
      // inside the end-to-end tier, so `test:e2e` stays a fast gate a person will run before
      // pushing. Runs only by name, outside the `test` aggregate and CI, until the endurance
      // reference run becomes a gate on every PR.
      "dependsOn": ["build:fixtures"],
      "inputs": [
        "src/renderer/src/**",
        "src/main/**",
        "src/shared/**",
        "fixtures/**",
        "tests/endurance/**",
        "tests/helpers/**",
        "vitest.config.*",
        "$TURBO_ROOT$/vitest.shared.ts",
        "vitest/**",
        "package.json",
        "out/**",
        "tests/budget/document.json"
      ],
      "outputs": [],
      "cache": false
    },
    // --- The bundle budgets -------------------------------------------------
    //
    // size-limit holding the renderer build to the budgets in `.size-limit.ts`, a task with
    // `inputs` like every tier above, so a run by name from a terminal, CI or `turbo run` has one
    // declared input set. It is `cache: false`: it reports on a build present now, and a cached
    // pass would report on one that is not.

    "budget:bundle": {
      // Measures a build, so it carries the same load-bearing edge the bundle tier does: reading
      // the chunk manifest fails loudly when `out/renderer` is absent rather than skipping, and the
      // edge makes the output present by construction.
      "dependsOn": ["build"],
      "inputs": [
        ".size-limit.ts",
        "tests/budget/built-renderer-tree.ts",
        "tests/helpers/fixture/bundle.ts",
        "out/renderer/**",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test": {
      // Every tier `.github/workflows/ci.yml` runs for the desktop, in the order the three build
      // flavors allow, so a developer's `pnpm test` and CI answer the same question. Its `desktop`
      // job gates every desktop PR on all of them but `test:e2e`, which its `desktop-slow` job runs
      // on the nightly run, on pull requests into `main` and on a manual run. Nothing checks that
      // the two sets agree; a PR that adds or removes a tier edits both lists in the same diff.
      //
      // The order is load-bearing and is why the script is a chain of `turbo run` invocations
      // rather than one. `build`, `build:smoke` and `build:fixtures` all write `out/**` and differ
      // in the `define` that decides what the renderer talks to, so one invocation would schedule
      // them concurrently and hand a tier the wrong bundle: the bundle budgets would measure a
      // fixture build against a release budget, and the bundle tier's release-absence assertions
      // would read a tree that legitimately contains what they refuse. The chain runs the
      // source-only tiers first, then the browser tier (which builds nothing), then release, smoke
      // and fixtures, each with its own consumers.
      //
      // No `dependsOn` of its own: every enumerated task declares the build edge it needs, and an
      // aggregate-level edge would run a build outside the sequence above rather than inside it.
      "outputs": [],
      "cache": false
    }
  }
}
