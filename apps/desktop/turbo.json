{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["src/**", "build/**", "electron.vite.config.ts", "tsconfig*.json", "package.json"],
      "outputs": ["out/**", "dist/**", ".tsbuildinfo"]
    },
    "build:smoke": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "build/**", "electron.vite.config.ts", "tsconfig*.json", "package.json"],
      "outputs": ["out/**", "dist/**"]
    },
    "typecheck": {
      "inputs": ["src/**", "test/**", "build/**", "scripts/**", "tsconfig*.json", "package.json"],
      "outputs": [".tsbuildinfo"]
    },
    "lint": {
      "inputs": [
        "src/**",
        "test/**",
        "build/**",
        "scripts/**",
        "*.{ts,tsx,js,mjs,cjs,json}",
        "eslint.config.mjs"
      ],
      "outputs": []
    },
    "test:renderer": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/**",
        "src/shared/**",
        "vitest.config.*",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:main-unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/main/**",
        "src/shared/**",
        "build/**",
        "test/helpers/**",
        "vitest.config.*",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/**",
        "src/shared/**",
        "vitest.config.*",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:smoke": {
      "dependsOn": ["build:smoke"],
      "inputs": ["test/**", "scripts/**", "vitest.config.*", "tsconfig*.json", "package.json"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["build:smoke"],
      "outputs": [],
      "cache": false
    }
  }
}
