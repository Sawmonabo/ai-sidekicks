{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    // --- The three build flavours ------------------------------------------
    //
    // All three write `out/**` and differ in exactly the `define` that decides
    // what the renderer talks to and whether the main process carries its test
    // probes. All three are therefore `cache: false`, and that is a correctness
    // requirement rather than a preference: a Turborepo cache HIT restores the
    // files it saved and does not empty the directory first, while a real run of
    // `electron-vite build` does (Vite's `emptyOutDir`). So a cached restore
    // layered over a sibling flavour's output leaves that sibling's
    // content-hashed chunks in place beside the restored ones — measured
    // 2026-09-02, where the bundle tier replayed a cached `build` over a
    // fixtures tree and `release-absence.test.ts` correctly found the fixture
    // tripwire handle in the orphaned chunk. Running the build is what makes the
    // flavour switch total.
    "build": {
      "inputs": [
        "src/**",
        "fixtures/**",
        "build/**",
        "electron.vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["out/**", "dist/**", ".tsbuildinfo"],
      "cache": false
    },
    "build:smoke": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "fixtures/**",
        "build/**",
        "electron.vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["out/**", "dist/**"],
      "cache": false
    },
    "build:fixtures": {
      // The renderer with its fixture implementations compiled in, for the two
      // Electron tiers.
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "fixtures/**",
        "build/**",
        "electron.vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["out/**", "dist/**"],
      "cache": false
    },
    "typecheck": {
      // `scripts/**` is in the input set because the harnesses there are
      // TypeScript and `tsconfig.scripts.json` typechecks them, so a change to
      // one has to invalidate this task.
      "inputs": [
        "src/**",
        "fixtures/**",
        "tests/**",
        "test/**",
        "build/**",
        "scripts/**",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [".tsbuildinfo"]
    },
    "lint": {
      "inputs": [
        "src/**",
        "fixtures/**",
        "tests/**",
        "test/**",
        "build/**",
        "scripts/**",
        "vitest/**",
        "eslint.restricted-syntax.mjs",
        "*.{ts,tsx,js,mjs,cjs,json}",
        "eslint.config.mjs"
      ],
      "outputs": []
    },
    // --- Structure gates ---------------------------------------------------
    //
    // Two tools, two disjoint claims, and deliberately TWO tasks rather than one fused gate.
    // `knip` answers "does an entry point reach this?"; `dependency-cruiser` answers "is this
    // import allowed to exist?". Neither subsumes the other — a dead module can be perfectly
    // layered, and a layering violation can sit on a fully reachable path — and a single task
    // running them in sequence would hide the second leg's findings behind the first leg's
    // exit code. CI runs both with `--continue`, so one red leg never conceals the other.
    //
    // Cacheable, unlike the test tiers: both legs read only files inside this package
    // plus the workspace-root manifest and `pnpm-workspace.yaml`, and a change to either of
    // those moves `pnpm-lock.yaml`, which Turborepo hashes globally.
    "structure:dead-code": {
      "inputs": [
        "src/**",
        "fixtures/**",
        "tests/**",
        "test/**",
        "build/**",
        "scripts/**",
        "$TURBO_ROOT$/knip.json",
        "vitest.config.ts",
        "vitest/**",
        "electron.vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": []
    },
    // Only `tsconfig.paths.json` of the tsconfigs: the cruise resolves through an explicit
    // extension list and that file's aliases, so no other tsconfig edit can change its
    // result. `package.json` stays because the script that invokes it lives there.
    "structure:layering": {
      "inputs": [
        "src/**",
        "fixtures/**",
        "build/**",
        "scripts/**",
        "vitest/**",
        ".dependency-cruiser.mjs",
        ".dependency-cruiser.layers.mjs",
        "tsconfig.paths.json",
        "package.json"
      ],
      "outputs": []
    },

    "test:main-unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/main/**",
        "src/shared/**",
        "build/**",
        // Named file by file rather than as `scripts/**`, on the `test:smoke`
        // precedent: a tree glob would pull in budget harnesses this project does
        // not read. The registry IS read — `launch-deadline.test.ts` holds the
        // harness bounds against the rows it serves.
        "scripts/test-changed.ts",
        "scripts/test-changed.test.ts",
        "scripts/budget/**",
        "tests/budget/budgets.json",
        "tests/helpers/**",
        "vitest.config.*",
        "vitest/**",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/**",
        "src/shared/**",
        "vitest.config.*",
        "vitest/**",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:smoke": {
      "dependsOn": ["build:smoke"],
      // Narrowed from `tests/**`: the tiers under `tests/<tier>/**` are not this
      // project's inputs, and leaving them here would invalidate the ~25-30 s
      // smoke build on every tier test edit.
      // `scripts/materialize-electron.ts` is named because this task runs it;
      // `scripts/**` would pull the budget harnesses in with it.
      "inputs": [
        "tests/*.test.ts",
        "test/*.test.ts",
        "tests/helpers/**",
        "scripts/materialize-electron.ts",
        "vitest.config.*",
        "vitest/**",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },

    // --- Test tiers ---------------------------------------------------------
    //
    // Each tier is its own task so a tier can be run, cached, and gated alone.
    // `cache: false` throughout for the same reason the tasks above carry it:
    // these assert against a tree state, and a cached pass would report on a
    // tree that is no longer there.

    "test:renderer": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/src/**",
        "src/shared/**",
        "fixtures/**",
        "tests/scenarios/**",
        "tests/helpers/**",
        "tests/endurance/streaming-lanes*",
        "tests/endurance/transcript-endurance*",
        "vitest.config.*",
        "vitest/**",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/src/**",
        "tests/browser/**",
        "tests/helpers/**",
        "test/console/**",
        "vitest.config.*",
        "vitest/**",
        "tsconfig.paths.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:screenshot": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/src/**",
        "tests/screenshot/**",
        "tests/helpers/**",
        "test/console/**",
        "vitest.config.*",
        "vitest/**",
        "tsconfig.paths.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:accessibility": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/renderer/src/**",
        "tests/accessibility/**",
        "tests/helpers/**",
        "test/console/**",
        "vitest.config.*",
        "vitest/**",
        "tsconfig.paths.json"
      ],
      "outputs": [],
      "cache": false
    },
    "test:bundle": {
      // The one tier that measures a BUILD rather than a source tree.
      // The `build` edge is load-bearing: the gate fails loudly when a build
      // output under `out/` is absent rather than skipping, and this edge is
      // what makes the output present by construction.
      "dependsOn": ["build"],
      "inputs": [
        "tests/budget/**",
        "test/console/budget/**",
        "scripts/budget/**",
        "vitest.config.*",
        "vitest/**",
        "tsconfig.paths.json",
        "electron.vite.config.ts",
        "src/renderer/src/console/core/fixture-globals.ts",
        "out/main/**",
        "out/preload/**",
        "out/renderer/**"
      ],
      "outputs": [],
      "cache": false
    },
    "test:e2e": {
      // The one tier that needs a FIXTURE build rather than a release one: it
      // drives the renderer against the fixture implementations, which the release
      // define folds out. The edge makes that bundle present by construction, so
      // the tier's skip-with-a-message path stays a developer convenience rather
      // than something CI can silently fall into.
      "dependsOn": ["build:fixtures"],
      "inputs": [
        "src/renderer/src/**",
        "src/main/**",
        "tests/e2e/**",
        "tests/helpers/**",
        "vitest.config.*",
        "vitest/**",
        "tsconfig.paths.json",
        "out/**"
      ],
      "outputs": [],
      "cache": false
    },
    "test:endurance": {
      // Same bundle, tens of seconds rather than milliseconds. Its own task
      // rather than a slow file inside the end-to-end tier, so `test:e2e`
      // stays a fast gate a person will run before pushing and the slow one is
      // named separately — both are on the `test` aggregate, in its last group.
      "dependsOn": ["build:fixtures"],
      "inputs": [
        "src/renderer/src/**",
        "src/main/**",
        "tests/endurance/**",
        "tests/helpers/**",
        "vitest.config.*",
        "vitest/**",
        "tsconfig.paths.json",
        "out/**"
      ],
      "outputs": [],
      "cache": false
    },
    "test:bench": {
      // Not one of the registered tiers, and
      // deliberately not on the `test` aggregate, because each run APPENDS its
      // absolutes to `tests/bench/ledger.json` — a curated record a person
      // reads, which no test run should rewrite as a side effect. It does gate: CI
      // runs it in its own step with the ledger pointed at the runner's temp
      // directory, and both arms assert a RATIO with a wide margin rather than a
      // millisecond count, so a noisy runner cannot fail it and the store's own
      // `mergeUpsert` losing its partitioning can.
      //
      // `passThroughEnv` is what makes that redirection reach the runner: Turborepo
      // 2's default `strict` env mode filters out every variable no task declares,
      // so without this line CI would append to the checked-in ledger instead.
      // Not `env`: the value is a path that differs per machine and says nothing
      // about what the task computes, and this task is uncached anyway.
      "inputs": [
        "src/renderer/src/**",
        "tests/bench/**",
        "vitest.config.*",
        "vitest/**",
        "tsconfig.paths.json"
      ],
      "passThroughEnv": ["CONSOLE_BENCH_LEDGER_PATH"],
      "outputs": [],
      "cache": false
    },
    // --- Scripts invoked by name (`scripts/**`) --------------------------------
    //
    // The two budget gates `package.json` declares as scripts — `budget:bundle` and
    // `budget:heap`. Each gets a task with `inputs` for the same reason every tier
    // above does: run by name from a terminal, from CI, or from a `turbo run` that
    // names it, with one declared input set rather than two implicit ones. Both are
    // `cache: false` — they report on a tree or a build that is present now, and a
    // cached pass would report on one that is not. The `test` aggregate below is in
    // this file rather than in this group: it is a chain of `turbo run` invocations
    // and not a `scripts/**` executable, and its own block says why its order is
    // load-bearing.

    "budget:bundle": {
      // Measures a BUILD, so it carries the same load-bearing edge the
      // bundle tier does: the harness refuses loudly when
      // `out/renderer` is absent rather than skipping, and this edge is what
      // makes the output present by construction.
      "dependsOn": ["build"],
      "inputs": [
        "scripts/budget/**",
        "tests/budget/budgets.json",
        "out/renderer/**",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "budget:heap": {
      // No build edge, because this harness takes no reading at all. The
      // `renderer-heap-at-rest` row is `enforced` and its `measuredBy` names the
      // endurance tier, which launches the built renderer; `measure-heap.mts` reads
      // the registry, reports where the reading lives, and refuses if the registry
      // ever names it as the measurer. So the gate's own source and the registry are
      // the whole input set, and `out/**` would be an input nothing here opens.
      "inputs": ["scripts/budget/**", "tests/budget/budgets.json", "package.json"],
      "outputs": [],
      "cache": false
    },
    "test": {
      // Every tier a desktop PR is gated on, in the order the three build
      // flavours allow, and the same order `.github/workflows/ci.yml` runs them
      // in — a developer's `pnpm test` and the required check answer the same
      // question. Nothing checks that the two sets agree; a PR that adds or
      // removes a tier edits both lists in the same diff, and a reviewer says so.
      //
      // The ORDER is load-bearing and is why the script is a chain of `turbo run`
      // invocations rather than one. `build`, `build:smoke`, and `build:fixtures`
      // all write `out/**` and differ in the `define` that decides what the
      // renderer talks to, so a single invocation would schedule them
      // concurrently and hand a tier the wrong bundle: the bundle tier would
      // measure a fixture build against a release budget, and its
      // release-absence assertions would read a tree that legitimately contains
      // what they refuse. Sequencing runs the source-only tiers first, then the
      // browser-mode pair (which builds nothing), then release, smoke, and
      // fixtures each with its own consumers.
      //
      // Two projects are deliberately absent, each with its reason:
      // `screenshot`, which compares nothing and writes local capture aids a
      // person looks at, and `bench`, which records timings into
      // a ledger and gates nothing.
      //
      // No `dependsOn` of its own: every enumerated task declares the build edge
      // it needs, and an aggregate-level edge would run a build outside the
      // sequence above rather than inside it.
      "outputs": [],
      "cache": false
    }
  }
}
