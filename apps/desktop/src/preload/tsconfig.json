{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Electron preload-script target — Node-context but with sandbox restrictions
  // (Spec-023 §Security Hardening Baseline locks `sandbox: true`). Same Node 22
  // tier as main; inherits repo strict TS + isolatedDeclarations posture via
  // tsconfig.node22.json -> tsconfig.base.json.
  //
  // Authored at Plan-023 Phase 1 T-023p-1-2 as a design-intent stub. Source
  // files (`index.ts`, `bridge.ts`) land at T-023p-1-4 and this config will be
  // wired into `apps/desktop/tsconfig.json` references at that task.
  "extends": "../../../../tsconfig.node22.json",
  "compilerOptions": {
    "outDir": "../../out/preload",
    "rootDir": ".",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["**/*"],
  "exclude": ["**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"]
}
