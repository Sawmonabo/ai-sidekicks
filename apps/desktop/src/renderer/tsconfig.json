{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Electron renderer-process target — browser-context (React 19, no Node types).
  // Extends `tsconfig.base.json` DIRECTLY (not tsconfig.node22.json) because the
  // renderer runs in a Chromium V8 environment, not Node. DOM lib types are
  // required; Node types are explicitly excluded (no `types: ["node"]`).
  //
  // `module: "esnext"` + `moduleResolution: "bundler"` is the idiomatic posture
  // for a Vite-bundled renderer: relative imports do not require `.js` extensions
  // and bundler-style resolution matches what vite/rollup actually do at build
  // time. This overrides the `nodenext` defaults inherited from tsconfig.base.json.
  //
  // Production-only graph: the `exclude` array drops every `__tests__/**` and
  // `*.{test,spec}.{ts,tsx}` file so vitest globals (`vi`, `expect`, etc.) never
  // leak into renderer production code's typegraph — a stray `vi.fn()` call in
  // `SessionBootstrap.tsx` would now be a TS error (caught here at typecheck)
  // instead of a runtime bundle failure. Renderer test files are typechecked by
  // the sibling `tsconfig.test.json` (noEmit, `composite: false`, includes only
  // `__tests__/**/*`) so they never enter the `tsc -b` composite-references walk.
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // `rootDir` is `src/`, not `src/renderer/`, so the renderer may import
    // `../shared/**` — a subtree BOTH processes compile (see
    // `src/shared/auxiliary-routes.ts` for why the auxiliary-route manifest has
    // to be shared rather than main-process-only). With `rootDir: "."` the first
    // such import is TS6059 ("file is not under rootDir"), which would make the
    // shared module importable in principle and a compile error in practice.
    //
    // `outDir` is NOT `../../out` and NOT `../../out/renderer`: the latter is the
    // directory `electron.vite.config.ts` gives the renderer BUNDLE, and the
    // former puts this project's emit one level above it, which lands
    // `out/renderer/**` in the same tree either way — so the bundle-budget
    // harness could not tell an emitted chunk from a typecheck artifact. Sending
    // the emit to its own `out/tsc-<project>` root keeps both properties at once:
    // `rootDir` stays wide enough for the shared subtree, and nothing this
    // project emits is ever mistaken for something the bundler produced. The
    // renderer BUNDLE is built by `electron-vite`, not by this emit, so nothing
    // about the shipped tree depends on either path.
    "outDir": "../../out/tsc-renderer",
    "rootDir": "..",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  // `../shared/**/*` is listed explicitly because a composite project must list
  // every file in its program (TS6307) — widening `rootDir` alone makes the
  // import legal but still unlisted. The renderer imports the shared
  // auxiliary-route manifest; main compiles the same subtree under the package
  // root config.
  "include": ["**/*", "../shared/**/*"],
  "exclude": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"]
}
