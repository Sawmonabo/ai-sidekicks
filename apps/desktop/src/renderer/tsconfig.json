{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Electron renderer-process target — browser-context (React 19, no Node types).
  // Extends `tsconfig.base.json` DIRECTLY (not tsconfig.node22.json) because the
  // renderer runs in a Chromium V8 environment, not Node. DOM lib types are
  // required; Node types are explicitly excluded (no `types: ["node"]`).
  //
  // `module: "esnext"` + `moduleResolution: "bundler"` is the idiomatic posture
  // for a Vite-bundled renderer: relative imports do not require `.js` extensions
  // and bundler-style resolution matches what vite/rollup actually do at build
  // time. This overrides the `nodenext` defaults inherited from tsconfig.base.json.
  //
  // Production-only graph: the `exclude` array drops every `__tests__/**` and
  // `*.{test,spec}.{ts,tsx}` file so vitest globals (`vi`, `expect`, etc.) never
  // leak into renderer production code's typegraph — a stray `vi.fn()` call in
  // `SessionBootstrap.tsx` would now be a TS error (caught here at typecheck)
  // instead of a runtime bundle failure. Renderer test files are typechecked by
  // the sibling `tsconfig.test.json` (noEmit, `composite: false`, includes only
  // `__tests__/**/*`) so they never enter the `tsc -b` composite-references walk.
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "../../out/renderer",
    "rootDir": ".",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["**/*"],
  "exclude": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"]
}
