{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Electron renderer-process target: browser context (React 19, no Node types). It extends
  // `tsconfig.base.json` directly, not `tsconfig.node.json`, because the renderer runs in
  // Chromium's V8, not Node. DOM lib types are required; Node types are excluded (no
  // `types: ["node"]`).
  //
  // `module: "esnext"` with `moduleResolution: "bundler"` is the idiomatic posture for a
  // Vite-bundled renderer: relative imports need no `.js` extension, and resolution matches what
  // vite and rollup do at build time. This overrides the `nodenext` defaults from the base.
  //
  // Production-only graph: `exclude` drops every `*.{test,spec}.{ts,tsx}` file so vitest globals
  // (`vi`, `expect`) never leak into the production typegraph; a stray `vi.fn()` in a production
  // source is then a typecheck error rather than a bundle failure. Test files are typechecked by
  // the sibling `tsconfig.test.json` (noEmit, `composite: false`), which keeps them out of the
  // `tsc -b` composite-references walk.
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // `rootDir` is the package root, not `src/renderer/`, so the renderer may import
    // `src/shared/**` (a subtree both processes compile) and `fixtures/**` (the scenario data the
    // fixture implementations play). A narrower root makes the first such import TS6059 ("file is
    // not under rootDir").
    //
    // `outDir` is not `../../out` or `../../out/renderer`: the latter is the directory
    // `electron.vite.config.ts` gives the renderer bundle, and the former puts this project's emit
    // one level above it, landing `out/renderer/**` in the same tree either way, so a reader of
    // the renderer build could not tell an emitted chunk from a typecheck artifact. Its own
    // `out/tsc-<project>` root keeps `rootDir` wide enough for the shared subtree and keeps
    // anything this project emits from being mistaken for bundler output. The renderer bundle is
    // built by `electron-vite`, not by this emit.
    "outDir": "../../out/tsc-renderer",
    "rootDir": "../..",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  // `../shared/**/*` and `../../fixtures/**/*` are listed explicitly because a composite project
  // must list every file in its program (TS6307); widening `rootDir` alone makes the import legal
  // but still unlisted. Main compiles the shared subtree under the package root config.
  //
  // Tests and their support files are typechecked by `tsconfig.test.json`. An exclude pattern is
  // anchored at this directory, so the fixtures' tests need their own line.
  "include": ["**/*", "../shared/**/*", "../../fixtures/**/*"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-support.ts",
    "**/*.test-support.tsx",
    "../../fixtures/**/*.test.ts"
  ]
}
