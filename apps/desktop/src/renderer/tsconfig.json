{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Electron renderer-process target — browser-context (React 19, no Node types).
  // Extends `tsconfig.base.json` DIRECTLY (not tsconfig.node.json) because the
  // renderer runs in a Chromium V8 environment, not Node. DOM lib types are
  // required; Node types are explicitly excluded (no `types: ["node"]`).
  //
  // `module: "esnext"` + `moduleResolution: "bundler"` is the idiomatic posture
  // for a Vite-bundled renderer: relative imports do not require `.js` extensions
  // and bundler-style resolution matches what vite/rollup actually do at build
  // time. This overrides the `nodenext` defaults inherited from tsconfig.base.json.
  //
  // Production-only graph: the `exclude` array drops every `*.{test,spec}.{ts,tsx}`
  // file so vitest globals (`vi`, `expect`, etc.) never leak into renderer
  // production code's typegraph — a stray `vi.fn()` call in a production source
  // file would be a TS error (caught here at typecheck) instead of a runtime
  // bundle failure. Renderer test files are typechecked by the sibling
  // `tsconfig.test.json` (noEmit, `composite: false`) so they never enter the
  // `tsc -b` composite-references walk.
  "extends": ["../../../../tsconfig.base.json", "../../tsconfig.paths.json"],
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // `rootDir` is the package root, not `src/renderer/`, so the renderer may import
    // `src/shared/**` (a subtree both processes compile) and `fixtures/**` (the
    // scenario data the fixture implementations play). A narrower root makes the
    // first such import TS6059 ("file is not under rootDir").
    //
    // `outDir` is NOT `../../out` and NOT `../../out/renderer`: the latter is the
    // directory `electron.vite.config.ts` gives the renderer BUNDLE, and the
    // former puts this project's emit one level above it, which lands
    // `out/renderer/**` in the same tree either way — so the bundle-budget
    // harness could not tell an emitted chunk from a typecheck artifact. Sending
    // the emit to its own `out/tsc-<project>` root keeps both properties at once:
    // `rootDir` stays wide enough for the shared subtree, and nothing this
    // project emits is ever mistaken for something the bundler produced. The
    // renderer BUNDLE is built by `electron-vite`, not by this emit, so nothing
    // about the shipped tree depends on either path.
    "outDir": "../../out/tsc-renderer",
    "rootDir": "../..",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  // `../shared/**/*` and `../../fixtures/**/*` are listed explicitly because a
  // composite project must list every file in its program (TS6307); widening
  // `rootDir` alone makes the import legal but still unlisted. Main compiles the
  // shared subtree under the package root config.
  //
  // Tests and their support files are typechecked by `tsconfig.test.json`. An
  // exclude pattern is anchored at this directory, so the fixtures' tests need
  // their own line.
  "include": ["**/*", "../shared/**/*", "../../fixtures/**/*"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-support.ts",
    "**/*.test-support.tsx",
    "../../fixtures/**/*.test.ts"
  ]
}
