{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Electron main-process target — Node-context, Electron 41 (Node 22 tier per
  // ADR-016 / ADR-022). Inherits repo strict TS + isolatedDeclarations posture
  // via tsconfig.node22.json -> tsconfig.base.json.
  //
  // Authored at Plan-023 Phase 1 T-023p-1-2 as a design-intent stub. Source
  // files (`index.ts`, `window.ts`) land at T-023p-1-3 and this config will be
  // wired into `apps/desktop/tsconfig.json` references at that task.
  "extends": "../../../../tsconfig.node22.json",
  "compilerOptions": {
    "outDir": "../../out/main",
    "rootDir": ".",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["**/*"],
  "exclude": ["**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"]
}
