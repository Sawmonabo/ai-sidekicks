{
  "name": "@ai-sidekicks/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop shell + renderer skeleton (Electron 41 / Node 22 tier per ADR-016/022).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "electron-vite build && node --experimental-strip-types build/assert-webprefs.ts",
    "build:smoke": "electron-vite build --mode=smoke && node --experimental-strip-types build/assert-webprefs.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p src/renderer/tsconfig.test.json && tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test:renderer": "vitest run --project=renderer --passWithNoTests",
    "test:smoke": "vitest run --project=main --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sidekicks/client-sdk": "workspace:*",
    "@ai-sidekicks/contracts": "workspace:*",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^41.1.0",
    "electron-vite": "^5.0.0",
    "happy-dom": "^19.0.0",
    "vitest": "catalog:testing"
  }
}
