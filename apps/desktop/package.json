{
  "name": "@ai-sidekicks/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop shell + renderer skeleton (Electron 44.x / Node 22 tier per ADR-016/022).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "postinstall": "node --experimental-strip-types scripts/materialize-electron.ts",
    "build": "electron-vite build && node --experimental-strip-types build/assert-webprefs.ts",
    "build:smoke": "electron-vite build --mode=smoke && node --experimental-strip-types build/assert-webprefs.ts",
    "build:fixtures": "electron-vite build --mode=fixtures && node --experimental-strip-types build/assert-webprefs.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p src/renderer/tsconfig.test.json && tsc -p tsconfig.console-browser-test.json && tsc -p tsconfig.console-electron-test.json && tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint build scripts src test",
    "test:renderer": "vitest run --project=renderer",
    "test:coverage": "vitest run --project=renderer --coverage",
    "test:main-unit": "vitest run --project=main-unit",
    "test:smoke": "node --experimental-strip-types scripts/materialize-electron.ts && vitest run --project=main",
    "test:console-unit": "vitest run --project=console-unit",
    "test:console-architecture": "vitest run --project=console-architecture",
    "test:console-assets": "vitest run --project=console-assets",
    "test:console-browser": "vitest run --project=console-browser",
    "test:console-screenshot": "vitest run --project=console-screenshot",
    "test:console-accessibility": "vitest run --project=console-accessibility",
    "test:console-e2e": "vitest run --project=console-e2e",
    "test:console-endurance": "vitest run --project=console-endurance",
    "test:console-bundle": "vitest run --project=console-bundle",
    "test:console-bench": "vitest run --project=console-bench",
    "budget:bundle": "node --experimental-strip-types scripts/budget/measure-bundle.mts",
    "budget:heap": "node --experimental-strip-types scripts/budget/measure-heap.mts",
    "test": "turbo run test:renderer test:main-unit test:smoke test:console-unit test:console-architecture test:console-assets --filter=@ai-sidekicks/desktop"
  },
  "dependencies": {
    "@ai-sidekicks/contracts": "workspace:*",
    "@base-ui/react": "1.7.0",
    "idb": "8.0.3",
    "react": "^19",
    "react-dom": "^19",
    "tinykeys": "4.0.0",
    "zod": "^4.3.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser": "catalog:testing",
    "@vitest/browser-playwright": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "axe-core": "4.13.0",
    "electron": "44.1.0",
    "electron-vite": "^5.0.0",
    "happy-dom": "^19.0.0",
    "vitest": "catalog:testing"
  }
}
