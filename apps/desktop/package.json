{
  "name": "@ai-sidekicks/desktop",
  "productName": "AI Sidekicks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "description": "The AI Sidekicks desktop app (Electron 44.x, Node 24).",
  "license": "Apache-2.0",
  "author": "Sawmon Abo",
  "engines": {
    "node": ">=24.21.0"
  },
  "imports": {
    "#renderer/*": "./src/renderer/src/*",
    "#main/*": "./src/main/*",
    "#preload/*": "./src/preload/*",
    "#shared/*": "./src/shared/*",
    "#test/*": "./tests/*",
    "#fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "postinstall": "node --experimental-strip-types scripts/materialize-electron.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:smoke": "electron-vite build --mode=smoke",
    "build:fixtures": "electron-vite build --mode=fixtures",
    "package": "electron-vite build && electron-builder --mac --dir",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p src/renderer/tsconfig.test.json && tsc -p tsconfig.browser-test.json && tsc -p tsconfig.electron-test.json && tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint build scripts src fixtures tests vitest",
    "test:coverage": "vitest run --project=renderer --coverage",
    "test:main-unit": "vitest run --project=main-unit",
    "test:smoke": "node --experimental-strip-types scripts/materialize-electron.ts && vitest run --project=smoke",
    "test:renderer": "vitest run --project=renderer",
    "test:browser": "vitest run --project=browser",
    "test:accessibility": "vitest run --project=accessibility",
    "test:e2e": "vitest run --project=e2e",
    "test:endurance": "vitest run --project=endurance",
    "test:bundle": "vitest run --project=bundle",
    "test:changed": "node --experimental-strip-types scripts/test-changed.ts",
    "budget:bundle": "size-limit",
    "structure:dead-code": "knip --directory ../.. --workspace apps/desktop --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "structure:layering": "depcruise src fixtures build scripts vitest --config .dependency-cruiser.mjs --output-type err",
    "structure": "pnpm run structure:dead-code && pnpm run structure:layering",
    "test": "turbo run test:main-unit test:renderer --filter=@ai-sidekicks/desktop && turbo run test:browser --filter=@ai-sidekicks/desktop --concurrency=1 && turbo run test:bundle budget:bundle --filter=@ai-sidekicks/desktop --concurrency=1 && turbo run test:smoke --filter=@ai-sidekicks/desktop --concurrency=1 && turbo run test:e2e --filter=@ai-sidekicks/desktop --concurrency=1"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "notify-status": "1.1.1"
  },
  "devDependencies": {
    "@ai-sidekicks/client-sdk": "workspace:*",
    "@ai-sidekicks/contracts": "workspace:*",
    "@ai-sidekicks/runtime-daemon": "workspace:*",
    "@ai-sidekicks/search-ranking": "workspace:*",
    "@base-ui/react": "1.8.0",
    "@dagrejs/dagre": "3.1.1",
    "@electron/fuses": "2.1.3",
    "@floating-ui/utils": "0.2.12",
    "@ibm/plex-mono-variable": "1.0.0",
    "@ibm/plex-sans-variable": "0.2.0",
    "@iconify-json/tabler": "1.2.41",
    "@mermanjs/web-render": "0.8.0",
    "@size-limit/file": "14.1.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@tanstack/react-virtual": "3.14.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "anser": "2.3.5",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.5.0",
    "devtools-protocol": "0.0.1707781",
    "diff": "9.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0-beta.5",
    "eslint-plugin-perfectionist": "5.12.1",
    "happy-dom": "~20.11.15",
    "hast-util-from-dom": "5.0.1",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-mdast": "10.1.2",
    "hast-util-to-text": "4.0.2",
    "idb": "8.0.3",
    "jsonc-parser": "3.3.1",
    "katex": "0.19.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.2.0",
    "memlab": "2.0.5",
    "micromark-extension-gfm": "3.0.0",
    "overlayscrollbars": "2.16.0",
    "perfect-freehand": "1.2.3",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.14.2",
    "remend": "1.4.0",
    "rollup-plugin-license": "3.7.1",
    "sass": "1.105.1",
    "signalsmith-stretch": "1.3.2",
    "size-limit": "14.1.0",
    "tinykeys": "4.0.1",
    "unplugin-icons": "24.0.0",
    "vitest": "catalog:testing",
    "zod": "catalog:",
    "zustand": "5.0.15"
  }
}
