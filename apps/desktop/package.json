{
  "name": "@ai-sidekicks/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop shell + renderer skeleton (Electron 41 / Node 22 tier per ADR-016/022).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.build.json && node --experimental-strip-types build/assert-webprefs.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sidekicks/client-sdk": "workspace:*",
    "@ai-sidekicks/contracts": "workspace:*",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-vite": "^5.0.0",
    "vitest": "catalog:testing"
  }
}
