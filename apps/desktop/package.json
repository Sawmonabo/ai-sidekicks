{
  "name": "@ai-sidekicks/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "description": "The AI Sidekicks desktop app (Electron 44.x, Node 24).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "postinstall": "node --experimental-strip-types scripts/materialize-electron.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node --experimental-strip-types build/assert-webprefs.ts",
    "build:smoke": "electron-vite build --mode=smoke && node --experimental-strip-types build/assert-webprefs.ts",
    "build:fixtures": "electron-vite build --mode=fixtures && node --experimental-strip-types build/assert-webprefs.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p src/renderer/tsconfig.test.json && tsc -p tsconfig.bench-test.json && tsc -p tsconfig.browser-test.json && tsc -p tsconfig.electron-test.json && tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint build scripts src fixtures tests vitest",
    "test:coverage": "vitest run --project=renderer --coverage",
    "test:main-unit": "vitest run --project=main-unit",
    "test:smoke": "node --experimental-strip-types scripts/materialize-electron.ts && vitest run --project=smoke",
    "test:renderer": "vitest run --project=renderer",
    "test:browser": "vitest run --project=browser",
    "test:screenshot": "UPDATE_SNAPSHOT=all vitest run --project=screenshot",
    "test:accessibility": "vitest run --project=accessibility",
    "test:e2e": "vitest run --project=e2e",
    "test:endurance": "vitest run --project=endurance",
    "test:bundle": "vitest run --project=bundle",
    "test:bench": "vitest run --project=bench",
    "test:changed": "node --experimental-strip-types scripts/test-changed.ts",
    "budget:bundle": "node --experimental-strip-types scripts/budget/measure-bundle.mts",
    "budget:heap": "node --experimental-strip-types scripts/budget/measure-heap.mts",
    "structure:dead-code": "knip --directory ../.. --workspace apps/desktop --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "structure:layering": "depcruise src fixtures build scripts vitest --config .dependency-cruiser.mjs --output-type err",
    "structure": "pnpm run structure:dead-code && pnpm run structure:layering",
    "test": "turbo run test:main-unit test:renderer --filter=@ai-sidekicks/desktop && turbo run test:browser test:accessibility --filter=@ai-sidekicks/desktop --concurrency=1 && turbo run test:bundle --filter=@ai-sidekicks/desktop --concurrency=1 && turbo run test:smoke --filter=@ai-sidekicks/desktop --concurrency=1 && turbo run test:e2e test:endurance --filter=@ai-sidekicks/desktop --concurrency=1"
  },
  "dependencies": {
    "@ai-sidekicks/contracts": "workspace:*",
    "@ai-sidekicks/search-ranking": "workspace:*",
    "@atlaskit/pragmatic-drag-and-drop": "3.1.0",
    "@base-ui/react": "1.7.0",
    "@tanstack/react-virtual": "3.14.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.11.6",
    "anser": "2.3.5",
    "diff": "9.0.0",
    "idb": "8.0.3",
    "katex": "0.18.5",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "^19",
    "react-dom": "^19",
    "react-resizable-panels": "4.12.3",
    "remend": "1.3.1",
    "shiki": "4.4.3",
    "tinykeys": "4.0.0",
    "yaml": "2.9.0",
    "zod": "4.3.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@ibm/plex-mono-variable": "1.0.0",
    "@ibm/plex-sans-variable": "0.2.0",
    "@iconify-json/tabler": "1.2.38",
    "@playwright/test": "1.62.1",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/mdast": "4.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser": "catalog:testing",
    "@vitest/browser-playwright": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.2.0",
    "devtools-protocol": "0.0.1687809",
    "electron": "44.1.0",
    "electron-vite": "^5.0.0",
    "eslint-plugin-perfectionist": "5.11.0",
    "happy-dom": "^19.0.0",
    "memlab": "2.0.5",
    "unplugin-icons": "23.0.1",
    "vitest": "catalog:testing"
  }
}
