{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-validates `scripts/`, the Node-context tools invoked by name from a package script, as
  // distinct from `build/`, which runs during `pnpm build` and has its own sibling config. Same
  // shape as `tsconfig.build.json`: `noEmit` plus an isolated buildinfo, so the scripts are
  // typechecked without entering the project-references graph or the production `dist/` layout.
  //
  // The scripts are TypeScript run through `node --experimental-strip-types`, and this is the one
  // config that checks them: `tsconfig.test.json` covers `src/**`, `tests/**` and the scripts'
  // tests, and `tsconfig.build.json` covers `build/**`. The package `typecheck` script reaches it.
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    // The package root, not `./scripts`: a script imports `src/shared/` modules through `#shared`
    // (the one failure formatter), and a `noEmit` pass still refuses a file outside `rootDir`
    // (TS6059). Nothing is emitted, so the wider root changes no output path.
    "rootDir": ".",
    // `isolatedDeclarations` needs `declaration`; `composite: false` keeps this config out of the
    // project-references graph.
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    // The scripts run under `node --experimental-strip-types`, which resolves the extension it is
    // given and maps no `.js` specifier to a `.ts` source, so their imports name the real file;
    // this option permits that (the documented posture for a `noEmit` project whose runtime loads
    // TypeScript directly).
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*"],
  // A test beside a script, and its support, import shared test helpers from `tests/helpers/`, so
  // `tsconfig.test.json` typechecks them instead.
  "exclude": ["dist", "out", "node_modules", "scripts/**/*.test.ts", "scripts/**/*.test-support.ts"]
}
