{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-validates `build/` (the release artifact's fuse check) without emitting. The production
  // `tsconfig.json` has `rootDir: ./src` and does not cover it; this sibling mirrors
  // `tsconfig.test.json` (noEmit, isolated buildinfo) so it stays out of the project-references
  // graph and the production `dist/` layout.
  //
  // One owner per directory: `scripts/` belongs to `tsconfig.scripts.json`.
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    // `isolatedDeclarations` needs `declaration`; `composite: false` keeps this config out of the
    // project-references graph.
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    // electron-builder loads the after-pack hook with Node, which rewrites no specifier, so the
    // hook's own imports name the real `.ts` file. Legal here because this config is `noEmit`.
    "allowImportingTsExtensions": true
  },
  "include": ["build/**/*"],
  "exclude": ["dist", "out", "node_modules"]
}
