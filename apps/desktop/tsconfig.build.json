{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-validates `build/` (the release artifact's fuse check) without emitting. The production
  // `tsconfig.json` has `rootDir: ./src` and does not cover it; this sibling mirrors
  // `tsconfig.test.json` (noEmit, isolated buildinfo) so it stays out of the project-references
  // graph and the production `dist/` layout.
  //
  // One owner per directory: `scripts/` belongs to `tsconfig.scripts.json`, whose harnesses need
  // `allowImportingTsExtensions` because `node --experimental-strip-types` rewrites no specifier.
  "extends": ["../../tsconfig.node.json", "./tsconfig.paths.json"],
  "compilerOptions": {
    "noEmit": true,
    // `isolatedDeclarations` needs `declaration`; `composite: false` keeps this config out of the
    // project-references graph.
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["build/**/*"],
  "exclude": ["dist", "out", "node_modules"]
}
