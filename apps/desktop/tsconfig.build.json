{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-validates the package's two executable-script directories without
  // emitting: `build/` (run DURING `pnpm build` — `assert-webprefs.ts`) and
  // `scripts/` (invoked BY NAME from a package script —
  // `materialize-electron.ts`, called by `postinstall` and `test:smoke`). The
  // production `tsconfig.json` has `rootDir: ./src` and covers neither; this
  // sibling mirrors the `tsconfig.test.json` pattern (noEmit + isolated
  // buildinfo) so both are typechecked without polluting the
  // project-references graph or the production `dist/` layout.
  //
  // `rootDir` is omitted rather than pinned to one of the two directories: with
  // `noEmit` it constrains nothing useful, and pinning it to `./build` would
  // make every `scripts/` file a TS6059 "not under rootDir" error. TS infers it
  // as the longest common ancestor of the include set, exactly as
  // `tsconfig.test.json` does for its own two-directory set.
  //
  // Authored at Plan-023 Phase 1 T-023p-1-3 alongside `build/assert-webprefs.ts`;
  // widened to `scripts/` at Plan-023 Phase 1B.
  "extends": "../../tsconfig.node22.json",
  "compilerOptions": {
    "noEmit": true,
    // `isolatedDeclarations` (inherited from base) requires either `declaration`
    // or `composite`; we keep `declaration: true` paired with `noEmit: true` so
    // the typechecker honors `isolatedDeclarations` constraints without writing
    // files (see TS5069). `composite: false` and a null buildinfo prevent this
    // config from polluting the project-references graph.
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["build/**/*", "scripts/**/*"],
  "exclude": ["dist", "out", "node_modules"]
}
