# The isolated linker is required for native bindings that must be built per runtime (Electron's ABI
# versus Node's): hoisted layouts collapse the distinction and break one runtime or the other.
# `node-pty` and `koffi` are such bindings; better-sqlite3 no longer is, since its 13.x Node-API
# prebuild is ABI-independent.
node-linker=isolated

# Strict build-script policy: only allowlisted packages may run install-time scripts. The allowlist
# lives in `pnpm-workspace.yaml` under `allowBuilds:` (pnpm 10.26+).
strict-dep-builds=true

# Disable pnpm's side-effects cache. It stores postinstall outputs (e.g. node-pty's
# `prebuild-install`-downloaded binding under `build/Release/`) keyed by package version and
# platform but not by Node ABI (`process.versions.modules`); see pnpm/pnpm#5002 (open). Jobs on
# different Node versions that share a store cache (keyed by lockfile only, actions/setup-node#641)
# can therefore restore a wrong-ABI binding and fail with "Module did not self-register". Disabling
# the cache forces `prebuild-install` to re-run per node_modules tree, picking the matching ABI
# prebuild every time. `pnpm rebuild` does not bypass the side-effects cache, so this flag, not a CI
# rebuild step, is the correct primitive.
#
# better-sqlite3 is not affected: on the 13.x Node-API line it runs no install script (denied in
# pnpm-workspace.yaml `allowBuilds`) and its binding is an ABI-independent prebuild loaded from the
# tarball, so it can neither populate this cache nor be poisoned by it.
side-effects-cache=false
