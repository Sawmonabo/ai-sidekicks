# Per ADR-022 §Decision row 1: isolated linker is required for two-ABI native bindings
# (Electron renderer + Node 22 daemon must hold distinct compiled binaries of better-sqlite3).
# Hoisted layouts collapse this distinction and break one runtime or the other.
# (better-sqlite3 stopped being such a binding on 2026-09-01 with the 13.x Node-API pin — one
# ABI-independent prebuild now serves both runtimes; see the side-effects-cache note below.
# node-pty and koffi still are, so the setting keeps its reason.)
node-linker=isolated

# Pnpm telemetry / Turborepo telemetry opt-out per ADR-022 (Turbo) and good-citizen default.
# Turborepo telemetry is also disabled at workflow level via TURBO_TELEMETRY_DISABLED=1.

# Strict build-script policy — only allowlisted packages may run install-time scripts.
# Allowlist itself lives in `pnpm-workspace.yaml` under `allowBuilds:` (pnpm 10.26+; replaces
# deprecated `pnpm.onlyBuiltDependencies` / `ignoredBuiltDependencies` per pnpm.io/settings).
strict-dep-builds=true

# Disable pnpm's side-effects cache. The cache stores postinstall outputs (e.g. node-pty's
# `prebuild-install`-downloaded binding under `build/Release/`) keyed by package version +
# platform but NOT by Node ABI (`process.versions.modules`); see pnpm/pnpm#5002 (open). On CI the
# daemon Node 22 (NODE_MODULE_VERSION 127) and control-plane Node 24 (NODE_MODULE_VERSION 137)
# jobs run in parallel against the same actions/setup-node@v5 pnpm-store cache (lockfile-keyed
# only — actions/setup-node#641), so whichever job's postinstall lands first wins and the loser
# reads back a wrong-ABI binding ⇒ "Module did not self-register". Disabling the side-effects
# cache forces `prebuild-install` to re-run per node_modules tree, picking the matching ABI
# prebuild every time. `pnpm rebuild` does NOT bypass the side-effects cache, so this flag — not
# a CI rebuild step — is the correct primitive.
#
# better-sqlite3 was the original example here and is no longer one: on the 13.x Node-API line it
# runs no install script at all (denied in pnpm-workspace.yaml `allowBuilds`), and its binding is
# an ABI-independent prebuild loaded from the tarball, so it can neither populate this cache nor
# be poisoned by it.
side-effects-cache=false
