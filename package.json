{
  "name": "ai-sidekicks",
  "version": "0.0.0",
  "private": true,
  "description": "A collaborative agent operating system for software work.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "prepare": "lefthook install",
    "structure:dead-code": "knip --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "test:mutation": "pnpm --filter './packages/*' --workspace-concurrency=1 --no-bail exec stryker run ../../stryker.config.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^24.19.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "^10.11.0",
    "eslint-plugin-check-file": "3.3.2",
    "knip": "6.39.0",
    "lefthook": "^2.2.0",
    "lint-staged": "^17.6.0",
    "prettier": "~3.8.5",
    "publint": "^0.3.25",
    "turbo": "^2.11.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "catalog:testing"
  }
}
