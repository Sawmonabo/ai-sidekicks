// Renovate config.
//
// An npm release waits pnpm's one-day `minimumReleaseAge` in pnpm-workspace.yaml, which every
// install enforces, so Renovate sets none for npm. A crate bump waits the same day through the cargo
// rule below, read from crates.io's publish time, and Cargo's own hold in `.cargo/config.toml`
// keeps a lock update to versions a day old.
//
// helpers:pinGitHubActionDigests pairs with the SHA-pinned third-party actions in
// .github/workflows/*.yml, and Renovate keeps the SHAs current. A current pin (pnpm/action-setup)
// resolves to an annotated-tag-object SHA from `git ls-remote refs/tags/<tag>`, not a commit SHA.
// GitHub Actions accepts both (it resolves through the tag object), so the immutable-pin property
// is identical, and the preset normalizes it to a commit SHA on the next bump.
//
// Dependabot is not used: it has no first-class minimum release age.

{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    // Force every Renovate PR's commit scope to `deps` (matches commitlint scope-enum). The type
    // defaults to `chore` from :semanticCommits, valid in our type-enum. Use :semanticCommitScope
    // (singular): Renovate emits one scope per PR, and the deprecated `:semanticCommitScopeAll`
    // preset does not exist in renovatebot/renovate (it would abort the extends chain with "Cannot
    // find preset's package"). Never use :semanticCommitTypeAll(deps): `deps` is not a valid
    // commitlint type and would block every Renovate PR.
    ":semanticCommitScope(deps)",
  ],
  // The Rust whose Cargo reads `.cargo/config.toml`'s publish-age hold.
  constraints: {
    rust: ">=1.100.0",
  },
  prConcurrentLimit: 5,
  prHourlyLimit: 4,
  // Hold major bumps for human review; minor/patch can group + automerge after CI green.
  packageRules: [
    {
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "pr",
      // Squash on automerge so Renovate PRs collapse to one commit on develop (`automergeStrategy`
      // applies on automerge; the top-level `squash: true` setting is invalid and
      // `renovate-config-validator --strict` rejects it).
      automergeStrategy: "squash",
    },
    {
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major"],
    },
    // A major bump of a CI or secret-scan action is labeled for review; the rule above already
    // keeps every major from automerging.
    {
      matchPackageNames: [
        "actions/checkout",
        "actions/setup-node",
        "pnpm/action-setup",
        "gitleaks/gitleaks-action",
      ],
      matchUpdateTypes: ["major"],
      labels: ["ci-actions", "review-required"],
    },
    // napi's WebAssembly build refuses to run unless emnapi and its two runtime packages are the
    // same version, so they move in one PR.
    {
      matchPackageNames: ["emnapi", "@emnapi/core", "@emnapi/runtime"],
      groupName: "emnapi",
    },
    // A direct crate bump waits a day after it is published, as an npm one does.
    {
      matchManagers: ["cargo"],
      minimumReleaseAge: "1 day",
    },
  ],
  // Lockfile maintenance keeps pnpm-lock.yaml fresh against transitive shifts.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 5am on monday"],
  },
  vulnerabilityAlerts: {
    enabled: true,
  },
}
