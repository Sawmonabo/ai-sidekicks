{
  "name": "@ai-sidekicks/contracts",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Shared protocol contracts, schema definitions, and cross-container types.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    "./*": {
      "@ai-sidekicks/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./event/version": null,
    "./gitflow/shared": null,
    "./internal/*": null,
    "./*.test": null,
    "./*.test-support": null,
    "./*.test-d": null
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test-d.ts"
  ],
  "scripts": {
    "build": "tsc -b",
    "generate": "node --experimental-strip-types generator/generate.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p generator/tsconfig.json",
    "lint": "eslint src generator",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "unicode-case-folding": "1.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:testing",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "~3.8.5",
    "vitest": "catalog:testing"
  }
}
