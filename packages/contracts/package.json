{
  "name": "@ai-sidekicks/contracts",
  "version": "0.0.0",
  "type": "module",
  "description": "Shared protocol contracts, schema definitions, and cross-container types.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    "./*": {
      "@ai-sidekicks/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./event/core": null,
    "./gitflow/shared": null,
    "./internal/*": null,
    "./*.test": null,
    "./*.test-support": null,
    "./*.test-d": null
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test-d.ts"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "unicode-case-folding": "1.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:testing",
    "vitest": "catalog:testing"
  }
}
