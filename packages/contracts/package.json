{
  "name": "@ai-sidekicks/contracts",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Shared protocol contracts, schema definitions, and cross-container types.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    "./*": {
      "@ai-sidekicks/source": "./src/generated/*.ts",
      "types": "./dist/generated/*.d.ts",
      "import": "./dist/generated/*.js"
    },
    "./app-link/uri": {
      "@ai-sidekicks/source": "./src/app-link/uri.ts",
      "types": "./dist/app-link/uri.d.ts",
      "import": "./dist/app-link/uri.js"
    },
    "./artifacts/payload-decoding": {
      "@ai-sidekicks/source": "./src/artifacts/payload-decoding.ts",
      "types": "./dist/artifacts/payload-decoding.d.ts",
      "import": "./dist/artifacts/payload-decoding.js"
    },
    "./daemon/repairing-line": {
      "@ai-sidekicks/source": "./src/daemon/repairing-line.ts",
      "types": "./dist/daemon/repairing-line.d.ts",
      "import": "./dist/daemon/repairing-line.js"
    },
    "./event/category-by-type": {
      "@ai-sidekicks/source": "./src/event/category-by-type.ts",
      "types": "./dist/event/category-by-type.d.ts",
      "import": "./dist/event/category-by-type.js"
    },
    "./jsonrpc/byte-length": {
      "@ai-sidekicks/source": "./src/jsonrpc/byte-length.ts",
      "types": "./dist/jsonrpc/byte-length.d.ts",
      "import": "./dist/jsonrpc/byte-length.js"
    },
    "./jsonrpc/page-fitting": {
      "@ai-sidekicks/source": "./src/jsonrpc/page-fitting.ts",
      "types": "./dist/jsonrpc/page-fitting.d.ts",
      "import": "./dist/jsonrpc/page-fitting.js"
    },
    "./machine/settings/environment-name": {
      "@ai-sidekicks/source": "./src/machine/settings/environment-name.ts",
      "types": "./dist/machine/settings/environment-name.d.ts",
      "import": "./dist/machine/settings/environment-name.js"
    },
    "./machine/settings/file": {
      "@ai-sidekicks/source": "./src/machine/settings/file.ts",
      "types": "./dist/machine/settings/file.d.ts",
      "import": "./dist/machine/settings/file.js"
    },
    "./name-fold": {
      "@ai-sidekicks/source": "./src/name-fold.ts",
      "types": "./dist/name-fold.d.ts",
      "import": "./dist/name-fold.js"
    },
    "./platform/check": {
      "@ai-sidekicks/source": "./src/platform/check.ts",
      "types": "./dist/platform/check.d.ts",
      "import": "./dist/platform/check.js"
    },
    "./provider/account/label": {
      "@ai-sidekicks/source": "./src/provider/account/label.ts",
      "types": "./dist/provider/account/label.d.ts",
      "import": "./dist/provider/account/label.js"
    },
    "./provider/driver/model-row": {
      "@ai-sidekicks/source": "./src/provider/driver/model-row.ts",
      "types": "./dist/provider/driver/model-row.d.ts",
      "import": "./dist/provider/driver/model-row.js"
    },
    "./schema-check": {
      "@ai-sidekicks/source": "./src/schema-check.ts",
      "types": "./dist/schema-check.d.ts",
      "import": "./dist/schema-check.js"
    },
    "./session/activity": {
      "@ai-sidekicks/source": "./src/session/activity.ts",
      "types": "./dist/session/activity.d.ts",
      "import": "./dist/session/activity.js"
    },
    "./session/event-cursor": {
      "@ai-sidekicks/source": "./src/session/event-cursor.ts",
      "types": "./dist/session/event-cursor.d.ts",
      "import": "./dist/session/event-cursor.js"
    },
    "./transcript/content": {
      "@ai-sidekicks/source": "./src/transcript/content.ts",
      "types": "./dist/transcript/content.d.ts",
      "import": "./dist/transcript/content.js"
    },
    "./transcript/run-attribution": {
      "@ai-sidekicks/source": "./src/transcript/run-attribution.ts",
      "types": "./dist/transcript/run-attribution.d.ts",
      "import": "./dist/transcript/run-attribution.js"
    },
    "./transcript/run-facts": {
      "@ai-sidekicks/source": "./src/transcript/run-facts.ts",
      "types": "./dist/transcript/run-facts.d.ts",
      "import": "./dist/transcript/run-facts.js"
    },
    "./transcript/turn-attribution": {
      "@ai-sidekicks/source": "./src/transcript/turn-attribution.ts",
      "types": "./dist/transcript/turn-attribution.d.ts",
      "import": "./dist/transcript/turn-attribution.js"
    },
    "./web-address/rule": {
      "@ai-sidekicks/source": "./src/web-address/rule.ts",
      "types": "./dist/web-address/rule.d.ts",
      "import": "./dist/web-address/rule.js"
    },
    "./workflow/definition/check": {
      "@ai-sidekicks/source": "./src/workflow/definition/check.ts",
      "types": "./dist/workflow/definition/check.d.ts",
      "import": "./dist/workflow/definition/check.js"
    },
    "./workflow/definition/check.wasm": "./dist/workflow-check.wasm",
    "./workflow/definition/handle-parsing": {
      "@ai-sidekicks/source": "./src/workflow/definition/handle-parsing.ts",
      "types": "./dist/workflow/definition/handle-parsing.d.ts",
      "import": "./dist/workflow/definition/handle-parsing.js"
    },
    "./event/version": null,
    "./git/shared": null,
    "./internal/*": null,
    "./checks/*": null,
    "./*.test": null,
    "./*.test-support": null
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "scripts": {
    "build": "cargo rustc -p sidekicks-contracts --lib --crate-type cdylib --profile wasm-release --target wasm32-unknown-unknown --features workflow-check-wasm --message-format=json-render-diagnostics | node --experimental-strip-types write-dist.ts && tsc -b --force",
    "generate": "node --experimental-strip-types generator/generate.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p generator/tsconfig.json && tsc -p tsconfig.write-dist.json",
    "lint": "eslint src generator write-dist.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "unicode-case-folding": "1.1.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:testing",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "~3.8.5",
    "vitest": "catalog:testing",
    "zod": "catalog:"
  }
}
