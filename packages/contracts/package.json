{
  "name": "@ai-sidekicks/contracts",
  "version": "0.0.0",
  "type": "module",
  "description": "Shared protocol contracts, schema definitions, and cross-container types.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "@ai-sidekicks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session": {
      "@ai-sidekicks/source": "./src/session.ts",
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/hashes": "^2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:testing",
    "vitest": "catalog:testing"
  }
}
