{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    // Node runs this source as stripped TypeScript (the `@ai-sidekicks/source` condition), which
    // refuses syntax that emits code: parameter properties, enums, namespaces with values.
    "erasableSyntaxOnly": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["src/**/*"],
  // Test files are excluded from `tsc -b` so they don't ship in `dist/`, as the package's `files`
  // leaves them out of `src/`; `tsconfig.test.json` type-validates them with `noEmit`. The
  // conditional-type tests beside the contract files they validate (`run/control.test-d.ts` next
  // to `run/control.ts`) are excluded by the same rule.
  "exclude": ["dist", "node_modules", "src/**/__tests__/**", "src/**/*.test-d.ts"]
}
