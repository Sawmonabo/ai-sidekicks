{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    // Node runs this source as stripped TypeScript (the `@ai-sidekicks/source` condition), which
    // refuses syntax that emits code: parameter properties, enums, namespaces with values.
    "erasableSyntaxOnly": true,
    // The workflow checks' loader runs on the page, and the DOM library declares the `WebAssembly`
    // API it and its glue call.
    "lib": ["es2024", "dom"],
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["src/**/*"],
  // Test files are excluded from `tsc -b` so they don't ship in `dist/`, as the package's `files`
  // leaves them out of `src/`; `tsconfig.test.json` type-validates them with `noEmit`.
  "exclude": ["dist", "node_modules", "src/**/__tests__/**"]
}
