{
  "name": "@ai-sidekicks/client-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The desktop's daemon client: the Rust client's Node-API addon, loaded in the desktop's client helper.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "client-sdk",
    "constEnum": false,
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "node --experimental-strip-types build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint build.ts tests",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ai-sidekicks/contracts": "workspace:*",
    "@napi-rs/cli": "3.10.12",
    "vitest": "catalog:testing"
  }
}
