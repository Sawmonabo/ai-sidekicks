{
  "name": "@ai-sidekicks/client-sdk",
  "version": "0.0.0",
  "type": "module",
  "description": "Typed client SDK used by desktop renderer and CLI.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "exports": {
    ".": {
      "@ai-sidekicks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sidekicks/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:testing",
    "vitest": "catalog:testing"
  }
}
