{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-validates test files without emitting. The production `tsconfig.json` excludes
  // `src/**/__tests__/**` so unit tests under `src/` don't ship in `dist/`; integration tests under
  // `test/` are outside its `include` glob entirely. This config covers both via a `noEmit` pass,
  // with `rootDir` widened to the package root so `test/**/*` is in scope.
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // `isolatedDeclarations` needs `declaration`; `composite: false` keeps this config out of the
    // project-references graph.
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["dist", "node_modules"]
}
