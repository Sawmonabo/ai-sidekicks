{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ai-sidekicks/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Control Plane services and shared-session coordination logic.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "exports": {
    ".": {
      "@ai-sidekicks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sidekicks/contracts": "workspace:*",
    "@trpc/server": "^11.19.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3",
    "vitest": "catalog:testing",
    "wrangler": "^4.145.0"
  }
}
