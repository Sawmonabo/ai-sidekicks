{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ai-sidekicks/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The control plane's gated Cloudflare Worker and its Postgres schema runner.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    ".": {
      "@ai-sidekicks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --project=node --coverage"
  },
  "dependencies": {
    "@ai-sidekicks/contracts": "workspace:*",
    "@trpc/server": "^11.19.0",
    "apns2": "^12.2.0",
    "google-auth-library": "^11.1.0",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "^10.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:testing",
    "wrangler": "^4.147.0"
  }
}
