{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo",
    // The Worker's runtime types beside Node's: the rate-limit Durable Object runs on Workers, and
    // the self-hosted relay runs this package's limiter on Node.
    "types": ["node", "@cloudflare/workers-types"]
  },
  "references": [{ "path": "../contracts" }],
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "src/**/__tests__/**"]
}
