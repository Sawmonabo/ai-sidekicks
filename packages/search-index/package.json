{
  "name": "@ai-sidekicks/search-index",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The daemon's session search index: Tantivy in a Node-API addon written in Rust.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "search-index",
    "constEnum": false,
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --esm",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.8"
  }
}
