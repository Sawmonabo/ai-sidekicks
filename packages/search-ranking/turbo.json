{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    // The build compiles `crates/sidekicks-search`'s matcher to WebAssembly and lays out `dist/`
    // through the repository's `tools/wasm-dist.ts`, then emits the loader beside it. The crate's
    // own build task carries the crate, the workspace's Cargo files and the toolchain file in its
    // hash.
    "build": {
      "dependsOn": ["^build", "sidekicks-search#build"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/tools/wasm-dist.ts"],
      "outputs": ["dist/**", ".tsbuildinfo"],
      // Cargo's job limit, its incremental setting (CI turns it off) and the toolchain's folders,
      // which Turborepo's strict environment mode would otherwise withhold from this package's
      // own Cargo run.
      "passThroughEnv": ["CARGO_BUILD_JOBS", "CARGO_INCREMENTAL", "CARGO_HOME", "RUSTUP_HOME"]
    },
    // The loader, and the script that lays out `dist/` with the tool it imports.
    "typecheck": {
      "inputs": ["$TURBO_EXTENDS$", "write-dist.ts", "$TURBO_ROOT$/tools/wasm-dist.ts"]
    }
  }
}
