{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-checks `write-dist.ts`, the build's last step, which Node runs as stripped TypeScript.
  // Nothing is emitted, and `composite: false` keeps it out of the project-references graph.
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    // Node strips the types and refuses syntax that emits code: enums, namespaces with values and
    // parameter properties.
    "erasableSyntaxOnly": true
  },
  "include": ["write-dist.ts"]
}
