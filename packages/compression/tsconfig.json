{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-checks `write-dist.ts`, the build's last step, which Node runs as stripped TypeScript, and
  // the repository's `tools/wasm-dist.ts` it imports. Nothing is emitted, and `composite: false`
  // keeps it out of the project-references graph.
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    // The repository root, so the imported tool sits under it: a `noEmit` pass still refuses a file
    // outside `rootDir` (TS6059), and nothing is emitted, so no output path changes.
    "rootDir": "../..",
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    // Node resolves the extension it is given and maps no `.js` specifier to a `.ts` source, so the
    // import names the real file.
    "allowImportingTsExtensions": true,
    // Node strips the types and refuses syntax that emits code: enums, namespaces with values and
    // parameter properties.
    "erasableSyntaxOnly": true
  },
  "include": ["write-dist.ts"]
}
