{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-validates the tests, which the source's `tsconfig.json` leaves out, without emitting.
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // `isolatedDeclarations` needs `declaration`; `composite: false` keeps this config out of the
    // project-references graph.
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "tests/**/*.ts", "rolldown.config.ts"],
  "exclude": ["dist", "node_modules"]
}
