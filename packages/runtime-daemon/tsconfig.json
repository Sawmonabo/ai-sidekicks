{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.node.json",
  // Type-checks only, writing nothing but its build info: rolldown writes the daemon's JavaScript,
  // bundled, and no entry exports anything to declare. `composite` stays for the solution's
  // `tsc -b`.
  "compilerOptions": {
    "noEmit": true,
    // Node runs this source as stripped TypeScript (the `@ai-sidekicks/source` condition), which
    // refuses syntax that emits code: parameter properties, enums, namespaces with values.
    "erasableSyntaxOnly": true,
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "references": [{ "path": "../contracts" }, { "path": "../search-ranking" }],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/**/__tests__/**", "src/**/__fixtures__/**"]
}
