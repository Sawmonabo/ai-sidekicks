{
  "name": "@ai-sidekicks/runtime-daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Runtime Daemon implementation and local execution services.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    "./typescript-source-loader": "./tests/helpers/typescript-source-loader.mjs",
    "./main": {
      "@ai-sidekicks/source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "bin": {
    "sidekicks-daemon": "./dist/main.js"
  },
  "files": [
    "dist",
    "tests/helpers/typescript-source-loader.mjs"
  ],
  "scripts": {
    "build": "tsc -b && rolldown -c rolldown.config.ts && pnpm run build:match-count",
    "build:match-count": "node scripts/build-match-count.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src tests scripts rolldown.config.ts",
    "test": "vitest run --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:endurance": "vitest run --project=endurance"
  },
  "dependencies": {
    "@ai-sidekicks/contracts": "workspace:*",
    "@ai-sidekicks/search-index": "workspace:*",
    "@ai-sidekicks/search-ranking": "workspace:*",
    "@anthropic-ai/sandbox-runtime": "0.0.78",
    "@cedar-policy/cedar-wasm": "4.13.0",
    "@dagrejs/dagre": "3.1.1",
    "@decimalturn/toml-patch": "3.3.0",
    "@hpke/core": "1.9.0",
    "@hpke/hybridkem-x-wing": "0.7.0",
    "@hyzyla/pdfium": "2.1.13",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@napi-rs/keyring": "2.1.0",
    "@noble/hashes": "catalog:",
    "better-sqlite3": "13.0.3",
    "bun": "1.4.2",
    "canonicalize": "5.1.0",
    "croner": "10.0.1",
    "fdir": "6.5.0",
    "ignore": "7.0.12",
    "jsonata": "2.2.2",
    "koffi": "^3.3.2",
    "lru-cache": "^11.5.3",
    "node-pty": "^1.2.0-beta.15",
    "nodemailer": "10.0.13",
    "picomatch": "4.0.7",
    "pidtree": "1.0.0",
    "pidusage": "4.0.1",
    "playwright-core": "1.63.0",
    "quickjs-emscripten": "0.32.0",
    "re2js": "2.8.6",
    "semver": "^7.8.5",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "web-push": "3.6.7",
    "yaml": "2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/pidusage": "2.0.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "catalog:testing",
    "rolldown": "1.2.12",
    "vitest": "catalog:testing"
  }
}
