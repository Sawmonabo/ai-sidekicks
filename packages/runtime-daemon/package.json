{
  "name": "@ai-sidekicks/runtime-daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Runtime Daemon implementation and local execution services.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "exports": {
    ".": {
      "@ai-sidekicks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sidekicks/contracts": "workspace:*",
    "@napi-rs/keyring": "2.1.0",
    "@noble/hashes": "^2.4.0",
    "better-sqlite3": "13.0.3",
    "canonicalize": "5.1.0",
    "lru-cache": "^11.5.3",
    "node-pty": "^1.2.0-beta.15",
    "semver": "^7.8.5",
    "shiki": "4.4.3",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.8",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "catalog:testing",
    "vitest": "catalog:testing"
  }
