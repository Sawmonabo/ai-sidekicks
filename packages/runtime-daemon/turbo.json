{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    // The build bundles the daemon by the bundle's config.
    "build": {
      "inputs": ["$TURBO_EXTENDS$", "rolldown.config.ts"]
    },
    // The bundle's config is type-checked with the tests.
    "typecheck": {
      "inputs": ["$TURBO_EXTENDS$", "rolldown.config.ts"]
    }
  }
}
