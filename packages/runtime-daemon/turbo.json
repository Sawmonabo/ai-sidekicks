{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    // The build bundles the daemon by the bundle's config.
    "build": {
      "inputs": ["$TURBO_EXTENDS$", "rolldown.config.ts"]
    },
    // The tests and the bundle's config are type-checked with the source, and the install script
    // that builds the daemon's SQLite shell on its own.
    "typecheck": {
      "inputs": ["$TURBO_EXTENDS$", "tests/**", "rolldown.config.ts", "sqlite-shell/*.ts"]
    },
    // The root inputs plus the tests and the SQLite shell's install script.
    "lint": {
      "inputs": ["$TURBO_EXTENDS$", "tests/**", "sqlite-shell/*.ts"]
    }
  }
}
