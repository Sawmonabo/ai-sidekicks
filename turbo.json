{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "remoteCache": {
    "signature": true
  },
  // The Cargo workspace joins the task graph beside the pnpm packages, and a task can name its own
  // command. Turbo's Cargo support is experimental, so `turbo` is pinned exact.
  "futureFlags": { "experimentalCargoWorkspaces": true, "experimentalTaskCommand": true },
  "globalDependencies": ["tsconfig.base.json", "tsconfig.node.json", "eslint.config.mjs"],
  // Strict environment mode withholds anything not named; Cargo reads this one.
  "globalEnv": ["CARGO_BUILD_WARNINGS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Keeps Turbo's own inputs for a crate: its dependencies, the root Cargo files, Cargo.lock.
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", ".tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      // `tsc -b` emits `dist/` beside `.tsbuildinfo`, and a later `tsc -b` trusts the build info
      // and never re-emits a missing output, so a cache hit restores both or neither.
      "outputs": ["dist/**", ".tsbuildinfo"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vitest.config.*", "tsconfig*.json", "package.json"],
      "outputs": [],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vitest.config.*", "tsconfig*.json", "package.json"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // The Cargo workspace's own checks, once for every crate. The daemon embeds the grammars its
    // engines' package builds, so every Cargo task waits for that build.
    "sidekicks-crates#lint": {
      "dependsOn": ["@ai-sidekicks/daemon-engines#build"],
      "command": [
        "cargo",
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--locked",
        "--keep-going"
      ]
    },
    // A package-scoped task does not inherit the shared test task's settings.
    "sidekicks-crates#test": {
      "dependsOn": ["sidekicks-crates#test:doc", "@ai-sidekicks/daemon-engines#build"],
      "cache": false,
      "command": ["cargo", "nextest", "run", "--workspace", "--all-features", "--locked"]
    },
    "sidekicks-crates#test:doc": {
      "dependsOn": ["@ai-sidekicks/daemon-engines#build"],
      "cache": false,
      "command": ["cargo", "test", "--workspace", "--doc", "--all-features", "--locked"]
    },
    // The daemon embeds the JavaScript bundles its engines run.
    "sidekicks-daemon#build": {
      "dependsOn": ["^build", "@ai-sidekicks/daemon-engines#build"]
    },
    // Crates a pnpm package compiles to WebAssembly: their build only carries the crate's hash.
    "sidekicks-compression#build": { "command": null },
    "sidekicks-search#build": { "command": null }
  }
}
